{
  "name": "nuage-autopilot5",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun test --isolate",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings packages",
    "lint:fix": "biome check --write packages",
    "check": "bun run typecheck && bun run lint",
    "format": "biome format --write packages"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
