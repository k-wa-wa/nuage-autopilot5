<mxfile host="app.diagrams.net" agent="autopilot" version="24.7.17">
  <diagram id="interrupts" name="自走中の割り込み">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="880" pageHeight="610" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="interrupts-title" value="自走中の割り込み — autopilot-run の実行中に、人間が窓口へ話しかけたとき" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="interrupts-i_start" value="自走中に人間が窓口へ話しかける" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="180" y="75" width="320" height="44" as="geometry" />
        </mxCell>
        <mxCell id="interrupts-i_status" value="窓口が autopilot-run status で実行中かを確かめる" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=12;fillColor=#d5f0ee;strokeColor=#4a9a94;" vertex="1" parent="1">
          <mxGeometry x="150" y="155" width="380" height="44" as="geometry" />
        </mxCell>
        <mxCell id="interrupts-i_dec" value="人間の意図は" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="220" y="235" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="interrupts-i_stop" value="方針を変えたい・議論したい&lt;br&gt;→ autopilot-run stop で止める。&lt;br&gt;担当を全部止め、status に&lt;br&gt;「stopped: 人間が停止した」を書く。&lt;br&gt;まとまったら brief.md を直して再起動する" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=12;fillColor=#d5f0ee;strokeColor=#4a9a94;" vertex="1" parent="1">
          <mxGeometry x="560" y="230" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="interrupts-i_prog" value="進捗を知りたい&lt;br&gt;→ status と run.log の末尾、&lt;br&gt;git log を読んで答える" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=12;fillColor=#d5f0ee;strokeColor=#4a9a94;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="interrupts-i_inbox" value="軽い追加指示 (止めなくてよい)&lt;br&gt;→ inbox.md に追記する。&lt;br&gt;次の修正の前に取り込まれ、修正担当が読む" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=12;fillColor=#d5f0ee;strokeColor=#4a9a94;" vertex="1" parent="1">
          <mxGeometry x="340" y="390" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="interrupts-i_note" value="実行中は窓口がコードを書き換えない。同じ worktree を並行で触ると壊れる。&lt;br&gt;担当エージェントの実行中は、人間に通知は鳴らない" style="whiteSpace=wrap;html=1;fontSize=12;shape=note;size=14;fillColor=#fffde7;strokeColor=#bdb76b;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="800" height="60" as="geometry" />
        </mxCell>
        <mxCell id="interrupts-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="interrupts-i_start" target="interrupts-i_status">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="interrupts-e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="interrupts-i_status" target="interrupts-i_dec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="interrupts-e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="interrupts-i_dec" target="interrupts-i_stop">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="interrupts-e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=block;endFill=1;exitX=0.25;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="interrupts-i_dec" target="interrupts-i_prog">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="interrupts-e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;endArrow=block;endFill=1;exitX=0.75;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="interrupts-i_dec" target="interrupts-i_inbox">
          <mxGeometry relative="1" as="geometry" />
