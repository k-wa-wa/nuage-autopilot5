<mxfile host="app.diagrams.net" agent="autopilot" version="24.7.17">
  <diagram id="models" name="モデルの切り替え">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="880" pageHeight="1160" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="models-title" value="モデルの切り替え — 実装・修正・レビュー・要約の、どの担当の実行にも共通する" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="models-m_s" value="担当を実行する&lt;br&gt;(実装・修正・レビュー・要約)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=50;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="75" width="340" height="50" as="geometry" />
        </mxCell>
        <mxCell id="models-m_order" value="試す並びを決める (models.yaml の段階ごとの並び)&lt;br&gt;この実行の中で失敗済みのモデルは外す&lt;br&gt;(全部が失敗済みなら、並びどおりにもう一度だけ試す)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="130" y="165" width="380" height="70" as="geometry" />
        </mxCell>
        <mxCell id="models-m_run" value="並びの次のモデルで担当エージェントを起動する" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="130" y="280" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="models-m_ok" value="正常終了したか" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="180" y="375" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="models-m_done" value="成功" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="395" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="models-m_mark" value="そのモデルを失敗済みとして覚える" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="130" y="510" width="380" height="44" as="geometry" />
        </mxCell>
        <mxCell id="models-m_next" value="並びに次のモデルが&lt;br&gt;あるか" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="180" y="595" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="models-m_f1" value="失敗 (試すモデルが尽きた)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=50;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="620" width="260" height="50" as="geometry" />
        </mxCell>
        <mxCell id="models-m_dirty" value="コードを書き換える作業&lt;br&gt;(実装・修正) で、作業ツリーが&lt;br&gt;実行の前から変わったか" style="whiteSpace=wrap;html=1;fontSize=12;rhombus;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="160" y="740" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="models-m_f2" value="失敗 (切り替えない)&lt;br&gt;別のモデルが続きを書くと混ざる" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=50;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="777" width="260" height="56" as="geometry" />
        </mxCell>
        <mxCell id="models-m_retry" value="次のモデルで試し直す (run.log に残す)" style="whiteSpace=wrap;html=1;fontSize=12;rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="130" y="925" width="380" height="44" as="geometry" />
        </mxCell>
        <mxCell id="models-m_note" value="・賢さの段階: 実装・修正は --level (既定 high)、レビューは high、要約は light&lt;br&gt;・段階ごとのモデルの並びは、ホストの models.yaml だけが決める。無ければ各 CLI の既定モデルで動く&lt;br&gt;・切り替えるのは、利用上限・認証切れ・モデルの廃止などで失敗したとき。下の段階へは自動で落とさない&lt;br&gt;・実装と修正は同じ会話を続ける。会話 ID を読めなければ、次の修正は新しい会話で始める" style="whiteSpace=wrap;html=1;fontSize=12;shape=note;size=14;fillColor=#fffde7;strokeColor=#bdb76b;align=left;spacingLeft=8;spacingRight=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
